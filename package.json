{
  "name": "a-stock-picker",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "A股智能选股与诊断系统 - 多维度技术面/基本面/资金面综合分析",
  "author": "Evan Chen",
  "license": "MIT",
  "homepage": "https://Evan05-Ai.github.io/a-stock-picker",
  "repository": {
    "type": "git",
    "url": "https://github.com/Evan05-Ai/a-stock-picker.git"
  },
  "keywords": [
    "stock",
    "a-share",
    "diagnosis",
    "selection",
    "react",
    "typescript"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:deploy": "VITE_BASE_PATH='/a-stock-picker/' vite",
